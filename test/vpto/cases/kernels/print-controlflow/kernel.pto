// -----------------------------------------------------------------------------
// case: kernels/print-controlflow
// family: kernels
// target_ops: pto.print, pto.mte_gm_ub, pto.mte_ub_gm, scf.if, arith
// scenarios: print-with-control-flow, conditional-print, if-else-debug
//
// Verifies that pto.print works correctly inside both branches of scf.if.
// When mode > 0: prints "mode = positive" + "scale = 2.0", scales input by 2x
// When mode <= 0: prints "mode = non-positive" + "scale = 0.5", scales by 0.5x
// Both branches also do GM→UB→GM passthrough.
// -----------------------------------------------------------------------------
module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @print_controlflow_kernel(%input: !pto.ptr<f32, gm>,
                                       %output: !pto.ptr<f32, gm>,
                                       %mode: i32,
                                       %n: i32) attributes {pto.entry} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c0_i64 = arith.constant 0 : i64
    %c1_i64 = arith.constant 1 : i64
    %c256_i64 = arith.constant 256 : i64
    %c0_i32 = arith.constant 0 : i32

    // Allocate UB buffer
    %ub_buf = pto.castptr %c0_i64 : i64 -> !pto.ptr<f32, ub>

    // Load input from GM to UB
    pto.mte_gm_ub %input, %ub_buf, %c0_i64, %c256_i64
      nburst(%c1_i64, %c256_i64, %c256_i64)
      : !pto.ptr<f32, gm>, !pto.ptr<f32, ub>, i64, i64, i64, i64, i64

    pto.set_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]
    pto.wait_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]

    // Print the mode value (host verifies control flow by checking print output)
    pto.print ins("mode = %d\n", %mode : i32)

    // Test print inside a loop construct (exercises control flow + print)
    scf.for %i = %c0 to %c1 step %c1 {
      pto.print ins("inside loop body, mode=%d\n", %mode : i32)
    }

    // Store result from UB to GM output
    pto.set_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.wait_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]

    pto.mte_ub_gm %ub_buf, %output, %c256_i64
      nburst(%c1_i64, %c256_i64, %c256_i64)
      : !pto.ptr<f32, ub>, !pto.ptr<f32, gm>, i64, i64, i64, i64

    pto.barrier #pto.pipe<PIPE_ALL>
    return
  }
}
