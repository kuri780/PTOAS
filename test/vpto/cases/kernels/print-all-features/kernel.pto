// -----------------------------------------------------------------------------
// case: kernels/print-all-features
// family: kernels
// target_ops: pto.print, pto.get_block_idx
// scenarios: full-integration, all-print-features, print-controlflow-integration
//
// Integrates scalar print with arithmetic values.
// TPrint is covered by its focused E2E cases.
// -----------------------------------------------------------------------------
module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @print_all_features_kernel(%value: f32,
                                        %total_elems: i32) attributes {pto.entry} {
    // ---- constants ----
    %block = pto.get_block_idx
    %block_idx = arith.index_cast %block : i64 to index
    %block_idx_i32 = arith.index_cast %block_idx : index to i32

    // Multiple scalar formats share one DebugTunnel buffer.
    pto.print ins("block %d\n", %block_idx_i32 : i32)
    pto.print ins("value = %+08.3f\n", %value : f32)
    pto.print ins("block %d\n", %block_idx_i32 : i32)
    pto.print ins("total_elems = %d\n", %total_elems : i32)

    return
  }
}
