// -----------------------------------------------------------------------------
// case: kernels/print-compute
// family: kernels
// target_ops: pto.print, pto.mte_gm_ub, pto.mte_ub_gm, pto.castptr, pto.barrier
// scenarios: print-plus-compute-coexistence, debug-tunnel-with-data-transfer,
//            gm-ub-roundtrip-with-print, integration-smoke-test
// -----------------------------------------------------------------------------
module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @print_compute_kernel(%input: !pto.ptr<f32, gm>,
                                   %output: !pto.ptr<f32, gm>,
                                   %offset: f32,
                                   %n: i32) attributes {pto.entry} {
    %c0_i64 = arith.constant 0 : i64
    %c1_i64 = arith.constant 1 : i64
    %c256_i64 = arith.constant 256 : i64

    // Debug: print the kernel parameters via DebugTunnel
    pto.print ins("offset = %+08.3f\n", %offset : f32)
    pto.print ins("n = %d\n", %n : i32)

    // Allocate UB buffer at byte offset 0
    %ub_buf = pto.castptr %c0_i64 : i64 -> !pto.ptr<f32, ub>

    // Load 64 x f32 (256 bytes) from GM to UB
    pto.mte_gm_ub %input, %ub_buf, %c0_i64, %c256_i64
      nburst(%c1_i64, %c256_i64, %c256_i64)
      : !pto.ptr<f32, gm>, !pto.ptr<f32, ub>, i64, i64, i64, i64, i64

    pto.set_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]
    pto.wait_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]

    // Store 64 x f32 (256 bytes) from UB to GM output
    pto.set_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.wait_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]

    pto.mte_ub_gm %ub_buf, %output, %c256_i64
      nburst(%c1_i64, %c256_i64, %c256_i64)
      : !pto.ptr<f32, ub>, !pto.ptr<f32, gm>, i64, i64, i64, i64

    pto.barrier #pto.pipe<PIPE_ALL>
    return
  }
}
