// -----------------------------------------------------------------------------
// case: kernels/print-multiblock
// family: kernels
// target_ops: pto.print, pto.get_block_idx, pto.mte_gm_ub, pto.mte_ub_gm
// scenarios: print-plus-get-block-idx, multi-block-debug, intrinsic-coexistence
//
// Verifies that pto.get_block_idx and pto.print coexist without intrinsic
// redefinition conflict.  Each block processes a slice of the input
// (32 elements per block, 2 blocks total for 64-element input).
// -----------------------------------------------------------------------------
module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @print_multiblock_kernel(%input: !pto.ptr<f32, gm>,
                                      %output: !pto.ptr<f32, gm>,
                                      %total_elems: i32) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c32 = arith.constant 32 : index
    %c0_i64 = arith.constant 0 : i64
    %c1_i64 = arith.constant 1 : i64
    %c128_i64 = arith.constant 128 : i64

    // Block index
    %block = pto.get_block_idx
    %block_idx = arith.index_cast %block : i64 to index
    %elem_offset = arith.muli %block_idx, %c32 : index

    // Print which block we are and its element offset
    %elem_offset_i32 = arith.index_cast %elem_offset : index to i32
    pto.print ins("block_offset = %d\n", %elem_offset_i32 : i32)

    // Compute byte offset for this block's slice: block * 32 elems * 4 bytes
    %gm_in = pto.addptr %input, %elem_offset : !pto.ptr<f32, gm> -> !pto.ptr<f32, gm>
    %gm_out = pto.addptr %output, %elem_offset : !pto.ptr<f32, gm> -> !pto.ptr<f32, gm>

    // Allocate UB buffer
    %ub_buf = pto.castptr %c0_i64 : i64 -> !pto.ptr<f32, ub>

    // Load this block's slice from GM to UB (32 x f32 = 128 bytes)
    pto.mte_gm_ub %gm_in, %ub_buf, %c0_i64, %c128_i64
      nburst(%c1_i64, %c128_i64, %c128_i64)
      : !pto.ptr<f32, gm>, !pto.ptr<f32, ub>, i64, i64, i64, i64, i64

    pto.set_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]
    pto.wait_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]

    // Store this block's slice from UB to GM
    pto.set_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.wait_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]

    pto.mte_ub_gm %ub_buf, %gm_out, %c128_i64
      nburst(%c1_i64, %c128_i64, %c128_i64)
      : !pto.ptr<f32, ub>, !pto.ptr<f32, gm>, i64, i64, i64, i64

    pto.barrier #pto.pipe<PIPE_ALL>
    return
  }
}
