// -----------------------------------------------------------------------------
// case: kernels/print-scalar-types
// family: kernels
// target_ops: pto.print, arith.constant
// scenarios: print-scalar-f16, print-scalar-f64, print-scalar-i32, print-scalar-i64
//
// Verifies that pto.print correctly lowers f16 (widened to i32),
// f64 (truncated to f32), i32 (sext to i64), and i64 (no extension)
// through the DebugTunnel protocol.  All values are kernel-side
// constants to avoid host-side type issues (e.g. __fp16).
// -----------------------------------------------------------------------------
module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @print_scalar_types_kernel() attributes {pto.entry} {
    %f16_val = arith.constant 1.500000e+00 : f16
    %f64_val = arith.constant 2.718281828e+00 : f64
    %i32_val = arith.constant -42 : i32
    %i64_val = arith.constant 1234567890123 : i64
    pto.print ins("f16=%f\n", %f16_val : f16)
    pto.print ins("f64=%f\n", %f64_val : f64)
    pto.print ins("i32=%d\n", %i32_val : i32)
    pto.print ins("i64=%d\n", %i64_val : i64)
    return
  }
}
