// -----------------------------------------------------------------------------
// case: kernels/print-vector-ops
// family: kernels
// target_ops: pto.print, pto.vlds, pto.vadd, pto.vsts, pto.vdup, pto.mte_gm_ub, pto.mte_ub_gm
// scenarios: print-with-vector-compute, vector-add-debug, vreg-roundtrip
//
// Verifies that vector ops (vlds/vadd/vsts) coexist with pto.print.
// Compute: output[i] = input[i] + input[i] = input[i] * 2  (vector self-add)
// Print emits the scale and element count.
// -----------------------------------------------------------------------------
module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @print_vector_ops_kernel(%input: !pto.ptr<f32, gm>,
                                      %output: !pto.ptr<f32, gm>,
                                      %scale: f32,
                                      %bias: f32,
                                      %n: i32) attributes {pto.entry} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c64 = arith.constant 64 : index
    %c0_i64 = arith.constant 0 : i64
    %c1_i64 = arith.constant 1 : i64
    %c256_i64 = arith.constant 256 : i64

    // Print the compute parameters
    pto.print ins("scale = %+08.3f\n", %scale : f32)
    pto.print ins("bias  = %+08.3f\n", %bias : f32)
    pto.print ins("n = %d\n", %n : i32)

    // Allocate separate UB regions for input and output (256 bytes each)
    %ub_input = pto.castptr %c0_i64 : i64 -> !pto.ptr<f32, ub>
    %ub_output = pto.castptr %c256_i64 : i64 -> !pto.ptr<f32, ub>

    // Load input from GM to UB
    pto.mte_gm_ub %input, %ub_input, %c0_i64, %c256_i64
      nburst(%c1_i64, %c256_i64, %c256_i64)
      : !pto.ptr<f32, gm>, !pto.ptr<f32, ub>, i64, i64, i64, i64, i64

    pto.set_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]
    pto.wait_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]

    // Vector compute: output = input * 2 (via self-add)
    pto.vecscope {
      %active = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>

      // Load input from UB to vector register (64 contiguous f32)
      %vec_in = pto.vlds %ub_input[%c0] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>

      // Self-add: doubles each element
      %result = pto.vadd %vec_in, %vec_in, %active : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>

      // Store result to UB output buffer (all 64 lanes)
      pto.vsts %result, %ub_output[%c0], %active : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
    }

    // Print completion marker with element count
    pto.print ins("vector compute done, n = %d\n", %n : i32)

    // Store result from UB to GM
    pto.set_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.wait_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]

    pto.mte_ub_gm %ub_output, %output, %c256_i64
      nburst(%c1_i64, %c256_i64, %c256_i64)
      : !pto.ptr<f32, ub>, !pto.ptr<f32, gm>, i64, i64, i64, i64

    pto.barrier #pto.pipe<PIPE_ALL>
    return
  }
}
